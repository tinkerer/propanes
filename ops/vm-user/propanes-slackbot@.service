# A member's own Slack bot (instance = ProPanes username). Same code as the
# operator's bot, its own Slack app and tokens, and a ProPanes token scoped to
# that member — it can see and launch exactly what they can, nothing more.
# Installed and configured by scripts/onboard-user.sh.
[Unit]
Description=ProPanes Slack bot for %i
After=network-online.target propanes.service propanes-launcher@%i.service
Wants=network-online.target

[Service]
Type=simple
User=pp-%i
Group=pp-%i
WorkingDirectory=/opt/propanes/slack-bot
EnvironmentFile=/etc/propanes/users/%i/slackbot.env
ExecStart=/usr/bin/node /opt/propanes/slack-bot/dist/index.js
Restart=on-failure
RestartSec=10
# Thread mappings and delivery checkpoints: /var/lib/propanes-slackbot/%i
StateDirectory=propanes-slackbot/%i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Model discovery runs the member's signed-in CLIs; let them refresh auth.
ReadWritePaths=-/home/pp-%i/.codex -/home/pp-%i/.claude

[Install]
WantedBy=multi-user.target
